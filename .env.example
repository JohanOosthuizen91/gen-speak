# Any OpenAI-compatible chat completions endpoint works. Defaults target Groq's free tier.
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Only the gpt-oss models accept this. Clear it if you switch LLM_MODEL to anything
# else, or the provider will reject every request with a 400.
LLM_REASONING_EFFORT=low

# Canonical origin, used for canonical URLs, the sitemap and social card images.
# Leave blank on Vercel until a custom domain exists; it falls back to the
# deployment URL automatically. No trailing slash.
NEXT_PUBLIC_SITE_URL=
